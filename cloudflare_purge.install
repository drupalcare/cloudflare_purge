/**
 * Implements hook_uninstall().
 */
function cloudflare_purge_uninstall($is_syncing) {
  if ($is_syncing) {
    return;
  }
  \Drupal::configFactory()
    ->getEditable('cloudflare_purge_form.settings')
    ->delete();
}
