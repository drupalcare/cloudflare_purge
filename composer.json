{
    "name": "drupal/cloudflare_purge",
    "description": "Cloudflare CDN cache purging via API with support for Bearer Token and API Key authentication methods.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/cloudflare_purge",
    "authors": [
        {
            "name": "Alaa Haddad",
            "email": "alaa@flashwebcenter.com",
            "homepage": "https://alaahaddad.com",
            "role": "Maintainer"
        },
        {
            "name": "Flash Web Center LLC",
            "homepage": "https://flashwebcenter.com",
            "role": "Organization"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/cloudflare_purge",
        "source": "https://git.drupalcode.org/project/cloudflare_purge"
    },
    "require": {
        "php": ">=8.1",
        "drupal/core": "^10 || ^11"
    },
    "require-dev": {
        "drupal/core-dev": "^10 || ^11"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "check-log-rendering": "php scripts/check-log-message-rendering.php"
    }
}
