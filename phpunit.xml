<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
  <php>
    <env name="SIMPLETEST_BASE_URL" value="http://localhost"/>
    <env name="SIMPLETEST_DB" value="mysql://user:pass@localhost/dbname"/>
  </php>
  <testsuites>
    <testsuite name="Cloudflare Purge Test Suite">
      <directory>./tests/src/Unit</directory>
      <directory>./tests/src/Kernel</directory>
    </testsuite>
  </testsuites>
  <!--
    No <source> element: it is PHPUnit 10+ only, and Drupal 10 ships PHPUnit 9,
    which rejects it with "Element 'source': This element is not expected" and
    then warns "Test results may not be as expected" on every run. PHPUnit 9's
    equivalent (<coverage><include>) is in turn deprecated in 10+, so no single
    element spans the versions this module supports. Nothing here generates
    coverage; pass the coverage-filter option on the command line if you need it.
  -->
</phpunit>
