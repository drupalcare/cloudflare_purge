<?php

/**
 * @file
 * Cloudflare Purge module.
 *
 * Provides comprehensive Cloudflare CDN cache purging capabilities including:
 * - Manual purge operations via admin UI
 * - Automatic cache tag integration
 * - Queue-based batch processing
 * - Drush command support.
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function cloudflare_purge_help(string $route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.cloudflare_purge':
      $output = '';
      $output .= '<h2>' . t('About') . '</h2>';
      $output .= '<p>' . t('The Cloudflare Purge module provides comprehensive cache purging capabilities for sites using Cloudflare CDN.') . '</p>';

      $output .= '<h2>' . t('Features') . '</h2>';
      $output .= '<ul>';
      $output .= '<li>' . t('<strong>Purge Everything:</strong> Clear the entire Cloudflare cache for your zone.') . '</li>';
      $output .= '<li>' . t('<strong>Purge by URL:</strong> Purge specific URLs (large lists are batched automatically, up to 100 per request).') . '</li>';
      $output .= '<li>' . t('<strong>Purge by Cache Tag:</strong> Purge content by cache tags (all plans).') . '</li>';
      $output .= '<li>' . t('<strong>Purge by Prefix:</strong> Purge all content under a URL prefix (all plans).') . '</li>';
      $output .= '<li>' . t('<strong>Purge by Hostname:</strong> Purge all content for specific hostnames (all plans).') . '</li>';
      $output .= '<li>' . t('<strong>Automatic Purging:</strong> Automatically purge Cloudflare when Drupal cache tags are invalidated.') . '</li>';
      $output .= '<li>' . t('<strong>Queue Support:</strong> Queue purge requests for batch processing during cron.') . '</li>';
      $output .= '<li>' . t('<strong>Drush Commands:</strong> Full Drush support for all purge operations.') . '</li>';
      $output .= '</ul>';

      $output .= '<h2>' . t('Configuration') . '</h2>';
      $output .= '<p>' . t('Configure your Cloudflare credentials at <a href=":url">Administration » Configuration » Cloudflare Purge</a>.', [
        ':url' => Url::fromRoute('cloudflare_purge.form')->toString(),
      ]) . '</p>';

      $output .= '<h2>' . t('Credential Storage') . '</h2>';
      $output .= '<p>' . t('Credentials can be stored in three ways (in priority order):') . '</p>';
      $output .= '<ol>';
      $output .= '<li>' . t('<strong>settings.php:</strong> Most secure, recommended for production.') . '</li>';
      $output .= '<li>' . t('<strong>Key module:</strong> Secure storage with the Key module.') . '</li>';
      $output .= '<li>' . t('<strong>Plain text:</strong> Stored in database configuration (least secure).') . '</li>';
      $output .= '</ol>';

      $output .= '<h2>' . t('Drush Commands') . '</h2>';
      $output .= '<ul>';
      $output .= '<li><code>drush cloudflare:purge-all</code> - ' . t('Purge entire cache') . '</li>';
      $output .= '<li><code>drush cloudflare:purge-url URL</code> - ' . t('Purge specific URL(s)') . '</li>';
      $output .= '<li><code>drush cloudflare:purge-tags TAG1 TAG2</code> - ' . t('Purge by cache tags') . '</li>';
      $output .= '<li><code>drush cloudflare:purge-prefixes PREFIX</code> - ' . t('Purge by URL prefix') . '</li>';
      $output .= '<li><code>drush cloudflare:purge-hostnames HOST</code> - ' . t('Purge by hostname') . '</li>';
      $output .= '<li><code>drush cloudflare:status</code> - ' . t('Check configuration status') . '</li>';
      $output .= '</ul>';

      return $output;

    case 'cloudflare_purge.form':
      return '<p>' . t('Configure your Cloudflare API credentials to enable cache purging. For security, consider storing credentials in settings.php or using the Key module.') . '</p>';

    case 'cloudflare_purge.settings':
      return '<p>' . t('Configure automatic cache purging behavior. When enabled, Cloudflare cache will be automatically purged when Drupal cache tags are invalidated.') . '</p>';

    case 'cloudflare_purge.purge_by_url':
      return '<p>' . t('Enter URLs to purge from the Cloudflare cache. URLs must be fully qualified including the scheme (https://).') . '</p>';

    case 'cloudflare_purge.purge_by_tag':
      return '<p>' . t('Enter cache tags to purge. Available on all Cloudflare plans. Free tier: 5 requests/minute, max 100 tags/request.') . '</p>';

    case 'cloudflare_purge.purge_by_prefix':
      return '<p>' . t('Enter URL prefixes to purge all content under those paths. Available on all Cloudflare plans.') . '</p>';

    case 'cloudflare_purge.purge_by_hostname':
      return '<p>' . t('Enter hostnames to purge all cached content for those domains. Available on all Cloudflare plans.') . '</p>';

    case 'cloudflare_purge.queued_tags':
      return '<p>' . t('Cache tags queued for a Cloudflare purge are merged into a deduplicated set so repeated invalidations of the same tag never create duplicate purge requests. This page is only relevant when queueing is enabled for automatic purging.') . '</p>';

    default:
      return '';
  }
}

/**
 * Implements hook_cron().
 */
function cloudflare_purge_cron(): void {
  try {
    $config = \Drupal::config('cloudflare_purge.settings');

    // Merge pending cache tags into batched, FIFO-ordered queue items before
    // the queue worker (which core's cron already invokes) runs. The queue
    // worker itself handles the actual purge processing.
    if ($config->get('auto_purge_use_queue') === TRUE) {
      \Drupal::service('cloudflare_purge.pending_tag_drainer')->drain();
    }

    // Log cron run if detailed logging is enabled.
    if ($config->get('logging_enabled') === TRUE) {
      \Drupal::logger('cloudflare_purge')->debug('Cloudflare Purge cron executed.');
    }
  }
  catch (\Exception $e) {
    \Drupal::logger('cloudflare_purge')->error('Error during cron: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
}
